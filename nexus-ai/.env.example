NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternative key name supported by the app if your Supabase dashboard shows anon key instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=

# Document RAG / AI server-side config
# mock runs the RAG UI without external services; supabase enables embeddings + pgvector + AI answers.
RAG_MODE=mock
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SUPABASE_SERVICE_ROLE_KEY=
RAG_MATCH_THRESHOLD=0.35
RAG_MATCH_COUNT=5

# Kanban Auto-Tasking uses OPENAI_CHAT_MODEL and falls back to a transparent
# mock generator when OPENAI_API_KEY is not configured or the model is unavailable.
